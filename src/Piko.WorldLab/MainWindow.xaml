<Window x:Class="Piko.WorldLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piko World Lab V0.1"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#15171C">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#20232A" Padding="12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Width="110" Height="32" Margin="0,0,8,0" Click="Capture_Click">Capture</Button>
                    <Button Width="130" Height="32" Margin="0,0,12,0" Click="Export_Click">Export snapshot</Button>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Foreground="#D9DEE8"
                           VerticalAlignment="Center"
                           Text="Ready to capture the physical-pixel desktop world." />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="12" Background="#0E1014" BorderBrush="#343944" BorderThickness="1">
                <Canvas x:Name="WorldCanvas" SizeChanged="WorldCanvas_SizeChanged" ClipToBounds="True" />
            </Border>
            <Border Grid.Column="1" Margin="0,12,12,12" Padding="12" Background="#20232A" BorderBrush="#343944" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Text="Compiled surfaces" />
                    <ListBox x:Name="SurfaceList"
                             Background="#15171C"
                             Foreground="#D9DEE8"
                             BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
