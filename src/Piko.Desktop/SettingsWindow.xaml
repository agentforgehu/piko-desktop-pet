<Window x:Class="Piko.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piko 设置" Width="580" Height="620" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F7F4EE" Foreground="#27333A"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="让 Piko 更适合你" />
            <TextBlock Margin="0,6,0,0" Foreground="#5B6A66" Text="陪伴从本地开始，额外能力由你开启。" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="White" BorderBrush="#D6DCD7">
            <TabItem Header="日常陪伴" Padding="10,8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
            <CheckBox x:Name="AutonomousCheck" Margin="0,8" FontSize="15" Content="允许自主活动" />
            <CheckBox x:Name="WindowCheck" Margin="0,8" FontSize="15" Content="允许探索窗口、攀爬和跳跃" />
            <CheckBox x:Name="PointerCheck" Margin="0,8" FontSize="15" Content="感知空闲鼠标并短暂驻足" />
            <CheckBox x:Name="FileCheck" Margin="0,8" FontSize="15" Content="观察下载目录和系统复制活动" />
            <CheckBox x:Name="MessagesCheck" Margin="0,8" FontSize="15" Content="显示 Piko 的状态气泡" />
            <CheckBox x:Name="ClickThroughCheck" Margin="0,8" FontSize="15" Content="鼠标穿透（用 Ctrl+Alt+P 召回）" />
            <CheckBox x:Name="StartupCheck" Margin="0,8" FontSize="15" Content="登录 Windows 后自动启动" />

            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="感知与隐私" Padding="10,8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
            <CheckBox x:Name="ForegroundActivityCheck" Margin="0,8" FontSize="15" Content="感知前台活动类别（开发、聊天、影视、游戏；不读取内容）" />
            <CheckBox x:Name="DevelopmentCheck" Margin="0,8" FontSize="15" Content="感知开发摘要（构建、测试、错误数量）" />
            <CheckBox x:Name="GitCheck" Margin="0,8" FontSize="15" Content="感知 Git 摘要（分支和变更数量，不读取代码）" />
            <CheckBox x:Name="AgentReadCheck" Margin="0,8" FontSize="15" Content="允许 Agent 只读工具（逐项确认访问目录）" />
            <CheckBox x:Name="MemoryCheck" Margin="0,8" FontSize="15" Content="启用加密本地记忆（可随时查看和全部删除）" />
<TextBlock Margin="0,16,0,8" TextWrapping="Wrap" Foreground="#5B6A66" Text="不截图，不采集浏览器、键盘或完整代码内容。只读工具需逐项选择并确认目录；当前版本不提供写文件或任意命令执行。" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="模型连接" Padding="10,8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
            <TextBlock Margin="0,8,0,3" Text="模型接入" />
            <ComboBox x:Name="ProviderCombo" Height="32" Padding="6,3">
                <ComboBoxItem Content="关闭模型（保留本地动作）" />
                <ComboBoxItem Content="OpenAI API" />
                <ComboBoxItem Content="本地 OpenAI-compatible 模型" />
            </ComboBox>
            <TextBlock Margin="0,8,0,3" Text="OpenAI API 地址" />
            <TextBox x:Name="AiEndpointText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" Text="OpenAI 模型" />
            <TextBox x:Name="AiModelText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" TextWrapping="Wrap" Text="API Key（留空则保持 Windows 凭据管理器中的现有值）" />
            <PasswordBox x:Name="AiApiKeyPassword" Height="30" Padding="6,3" />
            <CheckBox x:Name="ClearAiKeyCheck" Margin="0,8" Content="删除已保存的 API Key" />
            <TextBlock Margin="0,8,0,3" TextWrapping="Wrap" Text="本地兼容接口（只允许 127.0.0.1 / localhost）" />
            <TextBox x:Name="LocalAiEndpointText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" Text="本地模型 ID" />
            <TextBox x:Name="LocalAiModelText" Height="30" Padding="6,3" />

            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="称呼与性格" Padding="10,8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
            <TextBlock Margin="0,10,0,3" Text="称呼用户" />
            <ComboBox x:Name="AddressModeCombo" Height="32" Padding="6,3">
                <ComboBoxItem Content="主人" />
                <ComboBoxItem Content="使用你的名字" />
                <ComboBoxItem Content="其他称呼" />
            </ComboBox>
            <TextBlock Margin="0,8,0,3" Text="你的名字（选择“使用你的名字”时生效）" />
            <TextBox x:Name="UserNameText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" Text="其他称呼" />
            <TextBox x:Name="CustomAddressText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" Text="性格" />
            <TextBox x:Name="PersonalityText" Height="30" Padding="6,3" />
            <TextBlock Margin="0,8,0,3" Text="主动程度" />
            <ComboBox x:Name="ProactivityCombo" Height="32" Padding="6,3">
                <ComboBoxItem Content="低（只在明确事件时开口）" />
                <ComboBoxItem Content="中（适度关心和提醒）" />
                <ComboBoxItem Content="高（更频繁地主动互动）" />
            </ComboBox>

            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click">取消</Button>
            <Button x:Name="TestButton" Padding="14,8" Margin="0,0,8,0" Click="SaveAndTest_Click">保存并测试模型</Button>
            <Button x:Name="SaveButton" Padding="14,8" Background="#176455" Foreground="White" IsDefault="True" Click="Save_Click">仅保存</Button>
        </WrapPanel>
    </Grid>
</Window>
