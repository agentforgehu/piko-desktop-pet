<Window x:Class="Piko.Desktop.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="132"
        Height="164"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="SpeechBubble"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="128"
                Padding="9,5"
                Background="#EEFFFFFF"
                BorderBrush="#403B4A"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock x:Name="SpeechText"
                       FontSize="11"
                       Foreground="#27333A"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="我来啦" />
        </Border>

        <Canvas x:Name="BodyLayer" Width="116" Height="118" Margin="8,42,8,4" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.55">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FacingTransform" ScaleX="1" />
                    <RotateTransform x:Name="ModeRotation" Angle="0" />
                    <TranslateTransform x:Name="BodyMotion" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <Ellipse Canvas.Left="22" Canvas.Top="93" Width="28" Height="12" Fill="#3A2F3D" Opacity="0.22" />
            <Ellipse Canvas.Left="66" Canvas.Top="93" Width="28" Height="12" Fill="#3A2F3D" Opacity="0.22" />

            <Polygon Points="25,31 37,2 53,30" Fill="#F5A96D" Stroke="#403B4A" StrokeThickness="2" />
            <Polygon Points="63,30 80,3 91,35" Fill="#F5A96D" Stroke="#403B4A" StrokeThickness="2" />
            <Polygon Points="33,25 38,12 45,27" Fill="#FFD9C0" />
            <Polygon Points="72,27 79,13 84,29" Fill="#FFD9C0" />

            <Ellipse Canvas.Left="18" Canvas.Top="24" Width="80" Height="78" Stroke="#403B4A" StrokeThickness="2">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFD28C" Offset="0" />
                        <GradientStop Color="#F2956D" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="29" Canvas.Top="60" Width="58" Height="36" Fill="#FFE4C7" Opacity="0.92" />

            <Ellipse x:Name="LeftEye" Canvas.Left="38" Canvas.Top="49" Width="9" Height="14" Fill="#27333A" />
            <Ellipse x:Name="RightEye" Canvas.Left="69" Canvas.Top="49" Width="9" Height="14" Fill="#27333A" />
            <Ellipse Canvas.Left="41" Canvas.Top="51" Width="3" Height="4" Fill="White" />
            <Ellipse Canvas.Left="72" Canvas.Top="51" Width="3" Height="4" Fill="White" />
            <Path Canvas.Left="54" Canvas.Top="66" Data="M 0,0 C 3,4 5,4 8,0" Stroke="#403B4A" StrokeThickness="2" Fill="Transparent" />

            <Ellipse x:Name="TransferBadge" Visibility="Collapsed" Canvas.Left="84" Canvas.Top="22" Width="25" Height="25" Fill="#64C8A7" Stroke="White" StrokeThickness="2" />
            <TextBlock x:Name="TransferGlyph" Visibility="Collapsed" Canvas.Left="91" Canvas.Top="23" Foreground="White" FontSize="15" FontWeight="Bold" Text="↓" />
        </Canvas>

        <Canvas x:Name="PeekLayer" Width="24" Height="54" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Canvas.Left="0" Canvas.Top="3" Width="24" Height="48" Background="#F5A96D" BorderBrush="#403B4A" BorderThickness="0,2,2,2" CornerRadius="0,12,12,0" />
            <Ellipse Canvas.Left="5" Canvas.Top="15" Width="6" Height="11" Fill="#27333A" />
            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="6" Height="11" Fill="#27333A" />
            <Ellipse Canvas.Left="7" Canvas.Top="17" Width="2" Height="3" Fill="White" />
            <Ellipse Canvas.Left="17" Canvas.Top="17" Width="2" Height="3" Fill="White" />
        </Canvas>
    </Grid>
</Window>
