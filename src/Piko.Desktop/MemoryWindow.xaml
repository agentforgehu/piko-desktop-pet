<Window x:Class="Piko.Desktop.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piko 本地记忆"
        Width="620"
        Height="500"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F7F4EE"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#27333A" Text="Piko 本地记忆" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,12" Foreground="#647178" Text="正在读取…" />
        </StackPanel>

        <ListView x:Name="MemoryList" Grid.Row="1" BorderBrush="#D6D1C8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="145" DisplayMemberBinding="{Binding Created}" />
                    <GridViewColumn Header="类型" Width="85" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="摘要" Width="315" DisplayMemberBinding="{Binding Summary}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Height="34" Margin="0,0,10,0" Click="Refresh_Click">刷新</Button>
            <Button Width="110" Height="34" Margin="0,0,10,0" Click="DeleteAll_Click">删除全部记忆</Button>
            <Button Width="86" Height="34" IsCancel="True">关闭</Button>
        </StackPanel>
    </Grid>
</Window>
