<Window x:Class="Piko.Desktop.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和 Piko 聊聊" Width="620" Height="680" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F7F4EE" Foreground="#27333A"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CCD6D2" />
            <Setter Property="Foreground" Value="#234B45" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ClearButton" Margin="0,0,8,0" Click="Clear_Click">新对话</Button>
                <Button x:Name="SettingsButton" Click="Settings_Click">模型设置</Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="和 Piko 聊聊" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="说说你正在做什么，我在这里。" Margin="0,5,0,0" Foreground="#5B6A66" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#E7EEEA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在连接 Piko 后台…" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="BusyProgress" Height="3" Margin="0,8,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <TextBox x:Name="TranscriptText" Grid.Row="2" Padding="14" Background="White"
                 BorderBrush="#D6DCD7" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本次对话与本地工具结果" />
        <StackPanel x:Name="PlanPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="待确认的只读计划 · 选择一项" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ListBox x:Name="PlanList" MaxHeight="120" SelectionMode="Single"
                     SelectionChanged="PlanList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="待确认的只读计划">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsEnabled" Value="{Binding CanExecute}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#5B6A66" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="ExecuteButton" Margin="0,6,0,0" HorizontalAlignment="Right"
                    IsEnabled="False" Click="Execute_Click">选择目录并执行这一项…</Button>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="你想说什么？" Margin="0,0,0,5" />
            <TextBox x:Name="QuestionText" MinHeight="64" MaxHeight="110" Padding="10" MaxLength="4000"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     KeyDown="QuestionText_KeyDown" TextChanged="QuestionText_TextChanged"
                     AutomationProperties.Name="输入问题，Ctrl 加 Enter 发送，Enter 换行" />
            <DockPanel Margin="0,5,0,8">
                <TextBlock x:Name="CharacterCount" DockPanel.Dock="Right" Text="0 / 4000" Foreground="#5B6A66" />
                <TextBlock Text="Ctrl+Enter 发送 · Enter 换行" Foreground="#5B6A66" />
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="5">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopButton" Margin="0,0,8,0" Visibility="Collapsed" Click="Stop_Click">停止</Button>
                <Button x:Name="RetryButton" Margin="0,0,8,0" Visibility="Collapsed" Click="Send_Click">重试问题</Button>
                <Button x:Name="SendButton" MinWidth="88" Background="#176455" Foreground="White"
                        IsEnabled="False" Click="Send_Click">发送</Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="11" Foreground="#5B6A66" TextWrapping="Wrap"
                       Text="对话仅保留在本窗口。发送时使用当前问题、最近对话和已授权摘要；工具结果仅在本地显示。" />
        </Grid>
    </Grid>
</Window>
