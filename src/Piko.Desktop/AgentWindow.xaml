<Window x:Class="Piko.Desktop.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问 Piko"
        Width="540"
        Height="500"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F7F4EE"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#27333A" Text="问 Piko" />
            <TextBlock Margin="0,5,0,12" Foreground="#647178" TextWrapping="Wrap"
                       Text="只会发送你主动输入的问题和已授权的情境摘要。模型可以提出工具计划，但当前窗口不会自动执行任何工具。" />
        </StackPanel>

        <TextBox x:Name="TranscriptText"
                 Grid.Row="1"
                 Padding="12"
                 Background="White"
                 BorderBrush="#D6D1C8"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <TextBox x:Name="QuestionText"
                 Grid.Row="2"
                 Margin="0,12,0,10"
                 MinHeight="66"
                 MaxHeight="120"
                 Padding="10"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 KeyDown="QuestionText_KeyDown" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="86" Height="34" Margin="0,0,10,0" IsCancel="True">关闭</Button>
            <Button x:Name="ExecuteButton" Width="130" Height="34" Margin="0,0,10,0"
                    IsEnabled="False" Click="Execute_Click">执行只读计划…</Button>
            <Button x:Name="SendButton" Width="96" Height="34" IsDefault="True" Click="Send_Click">发送</Button>
        </StackPanel>
    </Grid>
</Window>
