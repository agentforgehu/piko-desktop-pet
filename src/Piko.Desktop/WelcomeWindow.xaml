<Window x:Class="Piko.Desktop.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎认识 Piko" Width="540" Height="600" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="#F7F4EE" Foreground="#27333A"
        FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Width="58" Height="58" CornerRadius="29" Background="#176455" HorizontalAlignment="Left">
                    <TextBlock Text="P" FontSize="34" FontWeight="SemiBold" Foreground="#FFF8EA"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="你好，我是 Piko。" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,8" />
                <TextBlock Text="我会住在你的桌面上，陪你工作，也陪你歇一会儿。" TextWrapping="Wrap" Foreground="#5B6A66" />
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,24,0,18">
                    <StackPanel>
                        <TextBlock Text="先记住这三个操作" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="拖动我 · 放到窗口边缘或桌面上" TextWrapping="Wrap" Margin="0,5" />
                        <TextBlock Text="右键或托盘 · 找到设置、隐藏和退出" TextWrapping="Wrap" Margin="0,5" />
                        <TextBlock Text="Ctrl+Alt+P · 随时把我叫回来" TextWrapping="Wrap" Margin="0,5" />
                    </StackPanel>
                </Border>
                <TextBlock Text="不配置模型，也能开始陪伴" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="默认在本地运行，不读取文件正文。开发摘要、模型、记忆和只读工具都需要你在设置中开启。" TextWrapping="Wrap" Foreground="#5B6A66" />
                <TextBlock Text="进入全屏应用时我会安静隐藏。单击可以聊天，双击可以设置；这些都可以稍后再试。" TextWrapping="Wrap" Foreground="#5B6A66" Margin="0,12,0,12" />
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="StartButton" Grid.Row="1" Content="开始陪伴" IsDefault="True" Click="Start_Click"
                Background="#176455" Foreground="White" Padding="20,10" Margin="0,18,0,0" HorizontalAlignment="Right" />
    </Grid>
</Window>
