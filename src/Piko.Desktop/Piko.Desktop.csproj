<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Piko</AssemblyName>
    <RootNamespace>Piko.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Piko Desktop Pet</Product>
    <Description>A local-first Windows desktop pet that lives on real window surfaces.</Description>
    <Authors>Piko contributors</Authors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piko.World\Piko.World.csproj" />
    <ProjectReference Include="..\Piko.World.Windows\Piko.World.Windows.csproj" />
  </ItemGroup>
</Project>
